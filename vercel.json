{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/cron/cid-sync",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/cron/rec-dismiss",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/cron/budget-alert",
      "schedule": "0 4 * * *"
    }
  ],
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "api.index:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
